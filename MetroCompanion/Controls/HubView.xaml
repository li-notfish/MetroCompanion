<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MetroCompanion.Controls.HubView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MetroCompanion.Behaviores">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid Background="Transparent" IgnoreSafeArea="True"
                  RowDefinitions="Auto, *">
                <!-- 壁纸铺满全屏 -->
                <Image
                    Grid.RowSpan="2"
                    x:Name="PART_ParallaxBg"
                    Aspect="AspectFill"
                    HorizontalOptions="Start"
                    InputTransparent="True"
                    Source="{TemplateBinding BackgroundSource}"
                    ZIndex="-1" />

                <!-- Header 区域（顶栏等，浮在壁纸上） -->
                <ContentPresenter
                    Grid.Row="0"
                    x:Name="PART_HeaderPresenter"
                    Content="{TemplateBinding Header}"
                    ZIndex="2" />

                <!-- Hub 内容区域 -->
                <ScrollView
                    Grid.Row="1"
                    x:Name="PART_ScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <ScrollView.Behaviors>
                        <OnPlatform x:TypeArguments="Behavior">
                            <On Platform="WinUI">
                                <behaviors:HubHorizontalScrollBehavior />
                            </On>
                        </OnPlatform>
                    </ScrollView.Behaviors>
                    <HorizontalStackLayout
                        x:Name="PART_SectionsContainer"
                        HorizontalOptions="Start"
                        Spacing="0"
                        VerticalOptions="Fill" />
                </ScrollView>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
