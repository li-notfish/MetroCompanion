<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MetroCompanion.Controls.HubView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MetroCompanion.Behaviores">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid Background="Transparent" IgnoreSafeArea="True">
                <Image
                    x:Name="PART_ParallaxBg"
                    Aspect="AspectFill"
                    HorizontalOptions="Start"
                    InputTransparent="True"
                    Source="{TemplateBinding BackgroundSource}"
                    ZIndex="-1" />

                <ScrollView
                    x:Name="PART_ScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <ScrollView.Behaviors>
                        <OnPlatform x:TypeArguments="Behavior">
                            <On Platform="WinUI">
                                <behaviors:HubHorizontalScrollBehavior />
                            </On>
                        </OnPlatform>
                    </ScrollView.Behaviors>
                    <HorizontalStackLayout
                        x:Name="PART_SectionsContainer"
                        HorizontalOptions="Start"
                        Spacing="0"
                        VerticalOptions="Fill" />
                </ScrollView>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
